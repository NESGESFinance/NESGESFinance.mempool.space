# Docker Compose Environment Variables - Example
# Copy this file to .env and set your own secure values

# Database Configuration
DATABASE_NAME=mempool
DATABASE_USERNAME=mempool
DATABASE_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD

# MySQL Root Password
MYSQL_ROOT_PASSWORD=CHANGE_THIS_TO_SECURE_ROOT_PASSWORD

# Bitcoin Core RPC Configuration
CORE_RPC_USERNAME=mempool
CORE_RPC_PASSWORD=CHANGE_THIS_TO_YOUR_BITCOIN_RPC_PASSWORD

# Security Notes:
# 1. Never commit the .env file to version control
# 2. Use strong, unique passwords for production
# 3. Consider using password managers or secret management tools
# 4. Rotate passwords regularly

# Generate secure passwords using:
# openssl rand -base64 32
